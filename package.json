{
  "name": "omnicopilot-dev",
  "displayName": "OmniRoute for GitHub Copilot Chat (Dev)",
  "description": "1200+ AI models in your Copilot Chat — free & forever free. Powered by OmniRoute: 340+ providers (90+ free) — Kimi, Claude, GPT, Gemini, GLM, DeepSeek, Qwen — with agent mode, tool calling, vision and auto-fallback. MIT open source.",
  "version": "1.3.0",
  "publisher": "diegosouzapw",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/diegosouzapw/OmniCopilot.git"
  },
  "bugs": {
    "url": "https://github.com/diegosouzapw/OmniCopilot/issues"
  },
  "homepage": "https://github.com/diegosouzapw/OmniRoute",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "language-models",
    "copilot",
    "github-copilot",
    "byok",
    "openai-compatible",
    "omniroute",
    "llm",
    "ai",
    "chat",
    "proxy",
    "router",
    "free-models",
    "claude",
    "gpt",
    "gemini",
    "deepseek",
    "kimi",
    "glm",
    "qwen",
    "ollama",
    "agent-mode",
    "tool-calling"
  ],
  "badges": [
    {
      "url": "https://img.shields.io/github/stars/diegosouzapw/OmniRoute?style=social",
      "description": "Star OmniRoute on GitHub",
      "href": "https://github.com/diegosouzapw/OmniRoute"
    }
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "languageModelTools": [
      {
        "name": "omniroute-dev_search",
        "displayName": "OmniRoute Search",
        "modelDescription": "Search the web or news through an automatically selected OmniRoute Search provider.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "query"
          ],
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "description": "Search query."
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "description": "Optional Search provider/model override."
            },
            "routeId": {
              "type": "string",
              "minLength": 1,
              "description": "Optional local OmniRoute route override; never sent upstream."
            },
            "max_results": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 5
            },
            "search_type": {
              "type": "string",
              "enum": [
                "web",
                "news"
              ],
              "default": "web"
            }
          }
        }
      },
      {
        "name": "omniroute-dev_rerank",
        "displayName": "OmniRoute Rerank",
        "modelDescription": "Rerank text documents through an automatically selected OmniRoute Rerank model.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "query",
            "documents"
          ],
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Non-empty relevance query."
            },
            "documents": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              },
              "description": "Documents to rank."
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "description": "Optional Rerank model override."
            },
            "routeId": {
              "type": "string",
              "minLength": 1,
              "description": "Optional local OmniRoute route override; never sent upstream."
            },
            "top_n": {
              "type": "integer",
              "minimum": 1
            },
            "return_documents": {
              "type": "boolean"
            }
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "omnicopilot-dev",
          "title": "OmniRoute",
          "icon": "assets/activity-icon.svg"
        }
      ]
    },
    "views": {
      "omnicopilot-dev": [
        {
          "type": "webview",
          "id": "omnicopilot-dev.panel",
          "name": "%view.connection%",
          "icon": "assets/activity-icon.svg"
        }
      ]
    },
    "languageModelChatProviders": [
      {
        "vendor": "omniroute-dev",
        "displayName": "OmniRoute (Dev)"
      },
      {
        "vendor": "omniroute-dev-2",
        "displayName": "OmniRoute (Dev) #2",
        "when": "omnicopilot-dev.routeCount >= 2"
      },
      {
        "vendor": "omniroute-dev-3",
        "displayName": "OmniRoute (Dev) #3",
        "when": "omnicopilot-dev.routeCount >= 3"
      },
      {
        "vendor": "omniroute-dev-4",
        "displayName": "OmniRoute (Dev) #4",
        "when": "omnicopilot-dev.routeCount >= 4"
      },
      {
        "vendor": "omniroute-dev-5",
        "displayName": "OmniRoute (Dev) #5",
        "when": "omnicopilot-dev.routeCount >= 5"
      },
      {
        "vendor": "omniroute-dev-6",
        "displayName": "OmniRoute (Dev) #6",
        "when": "omnicopilot-dev.routeCount >= 6"
      },
      {
        "vendor": "omniroute-dev-7",
        "displayName": "OmniRoute (Dev) #7",
        "when": "omnicopilot-dev.routeCount >= 7"
      },
      {
        "vendor": "omniroute-dev-8",
        "displayName": "OmniRoute (Dev) #8",
        "when": "omnicopilot-dev.routeCount >= 8"
      },
      {
        "vendor": "omniroute-dev-9",
        "displayName": "OmniRoute (Dev) #9",
        "when": "omnicopilot-dev.routeCount >= 9"
      },
      {
        "vendor": "omniroute-dev-10",
        "displayName": "OmniRoute (Dev) #10",
        "when": "omnicopilot-dev.routeCount >= 10"
      }
    ],
    "commands": [
      {
        "command": "omnicopilot-dev.manage",
        "category": "OmniRoute",
        "title": "%cmd.manage%"
      },
      {
        "command": "omnicopilot-dev.setApiKey",
        "category": "OmniRoute",
        "title": "%cmd.setApiKey%"
      },
      {
        "command": "omnicopilot-dev.refreshModels",
        "category": "OmniRoute",
        "title": "%cmd.refreshModels%"
      },
      {
        "command": "omnicopilot-dev.checkConnection",
        "category": "OmniRoute",
        "title": "%cmd.checkConnection%"
      },
      {
        "command": "omnicopilot-dev.openDashboard",
        "category": "OmniRoute",
        "title": "%cmd.openDashboard%"
      },
      {
        "command": "omnicopilot-dev.openGitHub",
        "category": "OmniRoute",
        "title": "%cmd.openGitHub%"
      },
      {
        "command": "omnicopilot-dev.installOmniRoute",
        "category": "OmniRoute",
        "title": "%cmd.installOmniRoute%"
      },
      {
        "command": "omnicopilot-dev.configureCliTool",
        "category": "OmniRoute",
        "title": "%cmd.configureCliTool%"
      },
      {
        "command": "omnicopilot-dev.quickActions",
        "category": "OmniRoute",
        "title": "%cmd.quickActions%"
      },
      {
        "command": "omnicopilot-dev.showStatusPopup",
        "category": "OmniRoute",
        "title": "%cmd.showStatusPopup%"
      },
      {
        "command": "omnicopilot-dev.openSettings",
        "category": "OmniRoute",
        "title": "%cmd.openSettings%"
      }
    ],
    "configuration": {
      "title": "OmniRoute for Copilot",
      "properties": {
        "omnicopilot-dev.baseUrl": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "%cfg.baseUrlDeprecated%"
        },
        "omnicopilot-dev.statusBar": {
          "type": "boolean",
          "default": true,
          "order": 2,
          "description": "%cfg.statusBar%"
        },
        "omnicopilot-dev.healthCheckIntervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 3600,
          "order": 3,
          "description": "%cfg.healthCheckIntervalSeconds%"
        },
        "omnicopilot-dev.maxOutputTokens": {
          "type": "number",
          "default": 16384,
          "minimum": 256,
          "order": 4,
          "description": "%cfg.maxOutputTokens%"
        },
        "omnicopilot-dev.defaultContextLength": {
          "type": "number",
          "default": 128000,
          "minimum": 1024,
          "order": 5,
          "description": "%cfg.defaultContextLength%"
        },
        "omnicopilot-dev.contextSafetyMarginTokens": {
          "type": "number",
          "default": 1024,
          "minimum": 0,
          "order": 6,
          "description": "%cfg.contextSafetyMarginTokens%"
        },
        "omnicopilot-dev.modelFilter": {
          "type": "string",
          "default": "",
          "order": 7,
          "description": "%cfg.modelFilter%"
        },
        "omnicopilot-dev.dashboardOpen": {
          "type": "string",
          "enum": [
            "external",
            "editor"
          ],
          "enumDescriptions": [
            "%cfg.dashboardOpen.external%",
            "%cfg.dashboardOpen.editor%"
          ],
          "default": "external",
          "order": 7,
          "description": "%cfg.dashboardOpen%"
        },
        "omnicopilot-dev.defaultReasoningEffort": {
          "type": "string",
          "enum": [
            "",
            "none",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "enumDescriptions": [
            "%cfg.defaultReasoningEffort.unset%",
            "%cfg.defaultReasoningEffort.none%",
            "%cfg.defaultReasoningEffort.low%",
            "%cfg.defaultReasoningEffort.medium%",
            "%cfg.defaultReasoningEffort.high%",
            "%cfg.defaultReasoningEffort.xhigh%"
          ],
          "default": "",
          "order": 8,
          "description": "%cfg.defaultReasoningEffort%"
        },
        "omnicopilot-dev.cliPath": {
          "type": "string",
          "default": "omniroute",
          "order": 9,
          "description": "%cfg.cliPath%"
        },
        "omnicopilot-dev.exposeToAgentsWindow": {
          "type": "boolean",
          "default": false,
          "order": 10,
          "description": "%cfg.exposeToAgentsWindow%"
        },
        "omnicopilot-dev.routes": {
          "type": "array",
          "default": [],
          "scope": "application",
          "description": "%cfg.routes%",
          "items": {
            "type": "object",
            "required": [
              "baseUrl"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier for the server route."
              },
              "name": {
                "type": "string",
                "description": "Display name for this OmniRoute server."
              },
              "baseUrl": {
                "type": "string",
                "description": "Base URL for this OmniRoute server (e.g. http://127.0.0.1:8000/v1)."
              }
            }
          }
        },
        "omnicopilot-dev.firstByteTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 5,
          "maximum": 600,
          "description": "%cfg.firstByteTimeoutSeconds%"
        },
        "omnicopilot-dev.idleTimeoutSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 600,
          "description": "%cfg.idleTimeoutSeconds%"
        },
        "omnicopilot-dev.fallbackMode": {
          "type": "string",
          "default": "sameModel",
          "enum": [
            "sameModel",
            "sameFamily",
            "full",
            "none"
          ],
          "enumDescriptions": [
            "%cfg.fallbackMode.sameModel%",
            "%cfg.fallbackMode.sameFamily%",
            "%cfg.fallbackMode.full%",
            "%cfg.fallbackMode.none%"
          ],
          "description": "%cfg.fallbackMode%"
        },
        "omnicopilot-dev.retriesPerServer": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 5,
          "description": "%cfg.retriesPerServer%"
        },
        "omnicopilot-dev.maxTools": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 128,
          "description": "%cfg.maxTools%"
        },
        "omnicopilot-dev.modelCacheTtlMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "maximum": 1440,
          "description": "%cfg.modelCacheTtlMinutes%"
        },
        "omnicopilot-dev.compressionOverride": {
          "type": "string",
          "default": "serverDefault",
          "enum": [
            "serverDefault",
            "off",
            "default",
            "engine:rtk",
            "engine:caveman"
          ],
          "enumDescriptions": [
            "%cfg.compressionOverride.serverDefault%",
            "%cfg.compressionOverride.off%",
            "%cfg.compressionOverride.default%",
            "%cfg.compressionOverride.rtk%",
            "%cfg.compressionOverride.caveman%"
          ],
          "description": "%cfg.compressionOverride%"
        },
        "omnicopilot-dev.transport": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "responses",
            "chatCompletions",
            "messages"
          ],
          "enumDescriptions": [
            "%cfg.transport.auto%",
            "%cfg.transport.responses%",
            "%cfg.transport.chatCompletions%",
            "%cfg.transport.messages%"
          ],
          "description": "%cfg.transport%"
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "icon": "node scripts/render-icon.mjs",
    "package": "npm run check-types && node esbuild.mjs --production",
    "vscode:prepublish": "npm run package",
    "vsix": "vsce package -o omnicopilot-dev.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.104.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vscode/vsce": "^3.7.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.13.0",
    "sharp": "^0.35.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.0.0"
  }
}
